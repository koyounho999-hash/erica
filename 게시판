// 가장 최상단에서 dotenv를 로드합니다.
require('dotenv').config();

const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const crypto = require('crypto');
const bcrypt = require('bcrypt');

const app = express();
app.use(express.json());

// 환경변수에서 GEMINI_API_KEY 확인
const GEMINI_API_KEY = process.env.GEMINI_API_KEY;

if (!GEMINI_API_KEY) {
  console.error('❌ 경고: GEMINI_API_KEY 환경변수가 설정되지 않았습니다.');
} else {
  console.log('✅ GEMINI_API_KEY 로드 완료');
}

// SQLite 파일 DB 연동
const db = new sqlite3.Database('./feedback_app.db');

// DB 테이블 초기화
db.serialize(() => {
  db.run(`
    CREATE TABLE IF NOT EXISTS feedbacks (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      username TEXT NOT NULL,
      content TEXT NOT NULL,
      rating INTEGER DEFAULT 5,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);

  db.run(`
    CREATE TABLE IF NOT EXISTS api_keys (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      client_name TEXT NOT NULL,
      hashed_key TEXT NOT NULL,
      is_active INTEGER DEFAULT 1,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);
});

// [미들웨어] API 키 검증 함수
const verifyApiKey = (req, res, next) => {
  const userApiKey = req.headers['x-api-key'];

  if (!userApiKey) {
    return res.status(401).json({ error: 'x-api-key 헤더에 API 키를 포함해야 합니다.' });
  }

  db.all('SELECT hashed_key FROM api_keys WHERE is_active = 1', [], async (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });

    let isValid = false;
    for (const row of rows) {
      const isMatch = await bcrypt.compare(userApiKey, row.hashed_key);
      if (isMatch) {
        isValid = true;
        break;
      }
    }

    if (isValid) {
      next();
    } else {
      return res.status(403).json({ error: '유효하지 않은 API 키입니다.' });
    }
  });
};

// 1. API 키 발급 엔드포인트
app.post('/api/keys/generate', async (req, res) => {
  const { clientName } = req.body;
  if (!clientName) return res.status(400).json({ error: '클라이언트 이름을 입력하세요.' });

  const rawApiKey = `ypt_${crypto.randomBytes(24).toString('hex')}`;
  const hashedKey = await bcrypt.hash(rawApiKey, 10);

  db.run(
    `INSERT INTO api_keys (client_name, hashed_key) VALUES (?, ?)`,
    [clientName, hashedKey],
    function (err) {
      if (err) return res.status(500).json({ error: err.message });
      
      res.status(201).json({
        message: 'API 키가 성공적으로 발급되었습니다.',
        clientName,
        apiKey: rawApiKey
      });
    }
  );
});

// 2. 피드백 게시판 API
app.post('/api/feedbacks', verifyApiKey, (req, res) => {
  const { username, content, rating } = req.body;

  if (!username || !content) {
    return res.status(400).json({ error: '작성자와 내용을 입력해 주세요.' });
  }

  db.run(
    `INSERT INTO feedbacks (username, content, rating) VALUES (?, ?, ?)`,
    [username, content, rating || 5],
    function (err) {
      if (err) return res.status(500).json({ error: err.message });
      res.status(201).json({ message: '피드백이 등록되었습니다.', feedbackId: this.lastID });
    }
  );
});

app.get('/api/feedbacks', verifyApiKey, (req, res) => {
  db.all(`SELECT * FROM feedbacks ORDER BY created_at DESC`, [], (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows);
  });
});

// 환경변수 PORT 값 불러오기 (기본값 3000)
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`🚀 서버가 포트 ${PORT}에서 실행 중입니다.`);
});
